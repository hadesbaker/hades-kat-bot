# Solana RPC URL — used for all on-chain reads, transaction submission, and
# WebSocket subscriptions (the bot derives wss:// from this URL).
# Free public endpoint shown; replace with a paid provider (QuikNode, Helius, etc.)
# for production use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Birdeye API key. Required only when birdeye_token_feed = true in config.toml.
# Overrides [birdeye] api_key.
BIRDEYE_API_KEY=

# Discord webhook URL for monitoring alerts. Optional.
# Overrides [monitoring] webhook_url.
DISCORD_WEBHOOK_URL=

# Comma-separated list of base58 wallet addresses to copy-trade.
TARGET_WALLETS=88888888,99999999,0000000000

# PumpPortal API base URL — used for /api/trade-local (HTTP) and /api/data (WS, derived).
# Override only if PumpPortal moves the endpoint or you front it with a proxy.
PUMPPORTAL_API_URL=https://pumpportal.fun

# PumpPortal API key — reserved for premium features. Not currently sent on any request.
PUMPPORTAL_API_KEY=
